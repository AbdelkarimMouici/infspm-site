---
// Self-hosted font: only the Arabic and Latin subsets, three weights.
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@fontsource/ibm-plex-sans-arabic/latin-400.css';
import '@fontsource/ibm-plex-sans-arabic/latin-600.css';
import '@fontsource/ibm-plex-sans-arabic/latin-700.css';
import '~/styles/global.css';

import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import StructuredData from '~/components/StructuredData.astro';
import { defaultLocale, localeMeta, locales, type Locale } from '~/i18n/config';
import { getDir, localizedPath, t } from '~/i18n/utils';

interface Props {
  locale: Locale;
  /** Page title (without the site name). Must be unique per page and language. */
  title: string;
  /** Meta description. Must be unique per page and language. */
  description: string;
  /** Translations of this page that exist (hreflang). Default: the same path in every language. */
  alternates?: Partial<Record<Locale, string>>;
  /** Language-switcher targets that differ from the hreflang translations (e.g. Arabic-fallback pages). */
  switchTargets?: Partial<Record<Locale, string>> | undefined;
  /** Exclude from search engines (404, utility pages). Also drops canonical and hreflang. */
  noindex?: boolean;
}

const { locale, title, description, alternates, switchTargets: switchOverrides, noindex = false } = Astro.props;
const dir = getDir(locale);
const siteName = t(locale, 'site.name');
const fullTitle = `${title} | ${siteName}`;

const site = Astro.site ?? new URL('https://example.invalid');
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).href;

// Which translations of this page exist. By default every locale has the same page.
// When `alternates` is given, only those locales (plus the current one) have a translation:
// hreflang lists only them, and the language switcher sends other locales to their home page.
const existing: Partial<Record<Locale, string>> = alternates
  ? { ...alternates, [locale]: pathname }
  : Object.fromEntries(locales.map((code) => [code, localizedPath(pathname, code)]));
const switchTargets = Object.fromEntries(
  locales.map((code) => [code, switchOverrides?.[code] ?? existing[code] ?? `/${code}/`]),
) as Record<Locale, string>;
const hreflangLinks = locales
  .filter((code) => existing[code] !== undefined)
  .map((code) => ({ hreflang: localeMeta[code].hreflang, href: new URL(existing[code] ?? `/${code}/`, site).href }));
const xDefaultPath = existing[defaultLocale];
const xDefault = xDefaultPath ? new URL(xDefaultPath, site).href : undefined;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1b4a70" />
    <!-- Sets the theme and the "js" class before the first paint (same-origin script, allowed by the CSP). -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {hreflangLinks.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
          {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
          {/* Open Graph: how links to the site look when shared. TODO(content): og:image once the logo exists. */}
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={siteName} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={localeMeta[locale].ogLocale} />
          {hreflangLinks
            .filter((alt) => alt.hreflang !== localeMeta[locale].hreflang)
            .map((alt) => (
              <meta
                property="og:locale:alternate"
                content={localeMeta[locales.find((code) => localeMeta[code].hreflang === alt.hreflang) ?? locale].ogLocale}
              />
            ))}
          <StructuredData />
        </>
      )
    }
  </head>
  <body class="bg-surface text-text antialiased">
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{t(locale, 'a11y.skipToContent')}</a>
    <SiteHeader locale={locale} alternates={switchTargets} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>
      import '~/scripts/interactions';
    </script>
  </body>
</html>
