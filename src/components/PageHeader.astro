---
// Page title block: the single <h1> of a page plus an optional lead paragraph.
import type { Locale } from '~/i18n/config';
import { getDir } from '~/i18n/utils';

interface Props {
  title: string;
  lead?: string;
  /** Language of the title when it differs from the page (Arabic fallback on French/English pages). */
  titleLang?: Locale | undefined;
}

const { title, lead, titleLang } = Astro.props;
const titleAttrs = titleLang ? { lang: titleLang, dir: getDir(titleLang) } : {};
---

<div class="page-hero">
  <div class="container-page">
    <slot name="before" />
    <h1 class="page-title rise" {...titleAttrs}>{title}</h1>
    {lead && <p class="page-lead rise rise-d1">{lead}</p>}
  </div>
</div>
