---
// Visible notice on text (translations and drafts) not yet validated by the administration.
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

interface Props {
  locale: Locale;
  /** Show the notice. Defaults to true: no interface text has been validated by the administration yet (TODO(content)). */
  show?: boolean;
}

const { locale, show = true } = Astro.props;
---

{
  show && (
    <p class="rounded-md border border-border bg-notice-soft px-4 py-2 text-sm text-on-notice" role="note">
      {t(locale, 'translation.needsReview')}
    </p>
  )
}
