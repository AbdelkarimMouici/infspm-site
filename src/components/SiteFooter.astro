---
// Site footer. Only confirmed facts (see docs/CONTENT.md).
// TODO(content): address, phone, opening hours and the Facebook page URL are not confirmed yet.
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { footerNav, navHref } from '~/config/navigation';
import { site } from '~/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="on-inverse mt-auto bg-inverse text-on-inverse">
  <div class="container-page grid gap-8 py-10 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{t(locale, 'site.shortName')}</p>
      <p class="mt-2 text-sm text-on-inverse-muted">{t(locale, 'site.name')}</p>
    </div>

    <nav aria-labelledby="footer-links-heading">
      <h2 id="footer-links-heading" class="text-base font-semibold">{t(locale, 'footer.linksHeading')}</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm" role="list">
        {
          footerNav.map((item) => (
            <li>
              <a href={navHref(locale, item.slug)} class="text-link-inverse hover:text-on-inverse">
                {t(locale, item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-base font-semibold">{t(locale, 'footer.contactHeading')}</h2>
      <p class="mt-3 text-sm">
        <span class="text-on-inverse-muted">{`${t(locale, 'footer.email')}: `}</span><a
          href={`mailto:${site.email}`}
          dir="ltr"
          class="ltr-inline text-link-inverse hover:text-on-inverse">{site.email}</a
        >
      </p>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="container-page py-4 text-xs text-on-inverse-muted">
      {`© ${year} ${t(locale, 'site.shortName')}. ${t(locale, 'footer.rights')}`}
    </p>
  </div>
</footer>
