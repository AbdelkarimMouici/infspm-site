---
// Minimal footer for step 1. Only confirmed facts (see docs/CONTENT.md).
// TODO(content): address, phone, hours and the Facebook page URL are not confirmed yet.
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const email = 'infspmtebessa@inpfp.dz';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-alt">
  <div class="container-page flex flex-col gap-2 py-6 text-sm text-muted">
    <p class="font-semibold text-text">{t(locale, 'site.name')}</p>
    <p>
      {`${t(locale, 'footer.email')}: `}<a href={`mailto:${email}`} dir="ltr">{email}</a>
    </p>
    <p><small>© {year}</small></p>
  </div>
</footer>
