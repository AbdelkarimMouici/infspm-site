---
// Site footer. Only confirmed facts (see docs/CONTENT.md).
// TODO(content): address, phone, opening hours and the Facebook page URL are not confirmed yet.
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { footerNav, navHref } from '~/config/navigation';
import { site } from '~/config/site';
import Logo from './Logo.astro';
import Scene3D from './Scene3D.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-auto">
  <svg class="wave-top -mb-px" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 48c240-40 480-40 720-8s480 40 720 0v40H0z"></path>
  </svg>
  <div class="on-inverse brand-band is-solid">
    <div class="brand-grid" aria-hidden="true"></div>
    <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="flex items-start gap-4">
        <span class="medallion size-16 shrink-0">
          <Logo size={60} alt="" />
        </span>
        <div>
          <p class="text-lg font-bold">{t(locale, 'site.shortName')}</p>
          <p class="mt-1 max-w-sm text-sm leading-relaxed">{t(locale, 'site.name')}</p>
        </div>
      </div>

      <nav aria-labelledby="footer-links-heading">
        <h2 id="footer-links-heading" class="text-base font-bold">{t(locale, 'footer.linksHeading')}</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm" role="list">
          {
            footerNav.map((item) => (
              <li>
                <a
                  href={navHref(locale, item.slug)}
                  class="inline-block py-0.5 no-underline transition-transform duration-300 hover:translate-x-1 hover:underline rtl:hover:-translate-x-1"
                >
                  {t(locale, item.label)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-base font-bold">{t(locale, 'footer.contactHeading')}</h2>
        <p class="mt-4 text-sm">
          <span>{`${t(locale, 'footer.email')}: `}</span><a
            href={`mailto:${site.email}`}
            dir="ltr"
            class="ltr-inline font-semibold">{site.email}</a
          >
        </p>
        <Scene3D scene="footer" class="mt-6 size-32" />
      </div>
    </div>
    <div class="border-t border-white/15">
      <p class="container-page py-5 text-xs">
        {`© ${year} ${t(locale, 'site.shortName')}. ${t(locale, 'footer.rights')}`}
      </p>
    </div>
  </div>
</footer>
