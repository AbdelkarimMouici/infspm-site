---
// Breadcrumb trail (WCAG 2.4.8 location). The last item is the current page (not a link).
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

interface Crumb {
  label: string;
  href?: string;
  /** Language of the label when it differs from the page. */
  lang?: string | undefined;
}

interface Props {
  locale: Locale;
  items: Crumb[];
}

const { locale, items } = Astro.props;
---

<nav aria-label={t(locale, 'breadcrumb.label')} class="mb-3 text-sm">
  <ol class="crumbs flex flex-wrap items-center gap-x-2 gap-y-1" role="list">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href}>
              {item.label}
            </a>
          ) : (
            <span aria-current="page" lang={item.lang} dir={item.lang ? "auto" : undefined}>
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
