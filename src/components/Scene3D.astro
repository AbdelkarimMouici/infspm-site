---
// A spot where the site-wide 3D layer (src/scripts/three/stage.ts) places interactive medical objects.
// Decorative only (aria-hidden). Shows a static illustration until the 3D layer is running, or instead of it
// (reduced motion, data saver, weak device, no JavaScript).
interface Props {
  /** Scene name from src/scripts/three/recipes.ts (unknown names use "default"). */
  scene: string;
  class?: string;
  /** Size of the static illustration. */
  fallback?: 'large' | 'small';
}

const { scene, class: className, fallback = 'small' } = Astro.props;
---

<div data-3d={scene} class:list={['scene-3d', className]} aria-hidden="true">
  <span class:list={['scene-fallback', fallback === 'large' ? 'is-large' : 'is-small']}>
    <svg viewBox="0 0 24 24" fill="none">
      <path
        d="M12 20.5s-7.6-4.6-9.5-9.3C1 7.7 3.2 4 6.9 4c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.7 0 5.9 3.7 4.4 7.2-1.9 4.7-9.5 9.3-9.5 9.3Z"
        fill="currentColor"
        opacity="0.22"></path>
      <path class="scene-pulse" d="M2.5 12h5l1.8-3.5 2.6 7 2.2-5 1.4 1.5h6" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</div>
