---
// Content card with 3D tilt and a moving light (pointer devices), lifted shadow and scroll reveal.
// When `href` is set, the whole card is clickable through the heading link
// (one link per card: no duplicate tab stops for screen-reader and keyboard users).
import type { Locale } from '~/i18n/config';
import { getDir } from '~/i18n/utils';

interface Props {
  title: string;
  href?: string;
  /** Heading level inside the page outline. */
  level?: 2 | 3;
  /** Small line above the title (date, category), always in the page language. */
  meta?: string | undefined;
  /** Language of the title/body when it differs from the page (e.g. an Arabic-only news item on the French site). */
  contentLang?: Locale | undefined;
  /** Decorative icon shown in a gradient bubble. */
  icon?: 'book' | 'register' | 'news' | 'contact' | 'spark' | undefined;
}

const { title, href, level = 3, meta, contentLang, icon } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const hasImage = Astro.slots.has('image');
const langAttrs = contentLang ? { lang: contentLang, dir: getDir(contentLang) } : {};

const icons: Record<string, string> = {
  book: 'M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2V5Zm0 14a2 2 0 0 1 2-2h12',
  register: 'M9 3h6l1 2h3v16H5V5h3l1-2Zm-1 9 3 3 5-6',
  news: 'M4 5h13v14H6a2 2 0 0 1-2-2V5Zm13 4h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5',
  contact: 'M4 6h16v12H4zM4 7l8 6 8-6',
  spark: 'M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6',
};
---

<article
  class="tilt reveal glow-border group relative flex h-full flex-col overflow-hidden rounded-lg shadow-card"
>
  {
    hasImage && (
      <div class="aspect-video overflow-hidden bg-surface-alt">
        <div class="h-full transition-transform duration-700 group-hover:scale-105">
          <slot name="image" />
        </div>
      </div>
    )
  }
  <div class="tilt-pop flex flex-1 flex-col gap-3 p-6">
    {
      icon && (
        <span
          class="grid size-12 place-items-center rounded-md text-white shadow-card transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-110"
          aria-hidden="true"
          data-gradient-bubble
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d={icons[icon]} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      )
    }
    {meta && <p class="text-sm font-medium text-muted">{meta}</p>}
    <slot name="badge" />
    <div class="flex flex-col gap-2" {...langAttrs}>
      <Heading class="text-lg font-bold leading-snug">
        {
          href ? (
            <a href={href} class="text-text no-underline after:absolute after:inset-0 after:z-10 hover:text-primary">
              {title}
            </a>
          ) : (
            title
          )
        }
      </Heading>
      <div class="text-muted">
        <slot />
      </div>
    </div>
    {
      href && (
        <span
          class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-bold text-accent transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1"
          aria-hidden="true"
        >
          <svg class="rtl:-scale-x-100" width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      )
    }
  </div>
</article>
