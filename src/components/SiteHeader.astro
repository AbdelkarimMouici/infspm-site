---
// Site header: wordmark, main navigation, language switcher.
// Mobile menu uses <details>/<summary>: works without JavaScript (strict CSP, no inline scripts).
// TODO(content): add the official logo next to the wordmark once provided (see docs/CONTENT.md).
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { isCurrent, mainNav, navHref } from '~/config/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates } = Astro.props;
const pathname = Astro.url.pathname;
const items = mainNav.map((item) => ({
  label: t(locale, item.label),
  href: navHref(locale, item.slug),
  current: isCurrent(pathname, locale, item.slug),
}));
---

<header class="border-b border-border bg-surface">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3">
    <a href={navHref(locale, '')} class="flex flex-col no-underline">
      <span class="text-lg font-bold leading-tight text-primary">{t(locale, 'site.shortName')}</span>
      <span class="hidden max-w-md text-xs leading-snug text-muted sm:block">{t(locale, 'site.name')}</span>
    </a>
    <LanguageSwitcher locale={locale} alternates={alternates} />
  </div>

  <nav aria-label={t(locale, 'nav.label')} class="border-t border-border bg-surface">
    <!-- Desktop: horizontal list -->
    <ul class="container-page hidden flex-wrap gap-x-1 py-1 lg:flex" role="list">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              class:list={[
                'inline-block border-b-2 px-3 py-2.5 font-medium no-underline',
                item.current
                  ? 'border-primary text-primary'
                  : 'border-transparent text-text hover:border-border hover:text-primary',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile: disclosure menu (no JavaScript) -->
    <details class="container-page py-2 lg:hidden">
      <summary
        class="menu-toggle inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-border px-4 font-semibold text-text hover:bg-surface-alt"
      >
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        {t(locale, 'nav.menu')}
      </summary>
      <ul class="mt-2 flex flex-col border-t border-border pt-2" role="list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-md px-3 font-medium no-underline',
                  item.current ? 'bg-primary-soft text-primary' : 'text-text hover:bg-surface-alt',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
