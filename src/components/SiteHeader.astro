---
// Site header: sticky frosted glass bar with the logo, main navigation, language switcher and theme toggle.
// Mobile menu uses <details>/<summary>: works without JavaScript (strict CSP, no inline scripts).
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { isCurrent, mainNav, navHref } from '~/config/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import MotionToggle from './MotionToggle.astro';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates } = Astro.props;
const pathname = Astro.url.pathname;
const items = mainNav.map((item) => ({
  label: t(locale, item.label),
  href: navHref(locale, item.slug),
  current: isCurrent(pathname, locale, item.slug),
}));
---

<header class="site-header glass border-b border-border/60">
  <div class="container-page flex items-center gap-3 py-2.5">
    <a href={navHref(locale, '')} class="group flex min-w-0 items-center gap-3 no-underline xl:shrink-0">
      <span class="site-logo medallion size-12 shrink-0 transition-transform duration-500 group-hover:rotate-12">
        <Logo size={44} alt="" eager />
      </span>
      <span class="flex min-w-0 flex-col xl:sr-only 2xl:not-sr-only">
        <span class="whitespace-nowrap text-base font-bold leading-tight text-primary sm:text-lg">{t(locale, 'site.shortName')}</span>
        <span class="hidden max-w-xs truncate text-xs leading-snug text-muted md:block xl:hidden 2xl:block">{t(locale, 'site.name')}</span>
      </span>
    </a>

    <nav aria-label={t(locale, 'nav.label')} class="ms-auto hidden xl:block">
      <ul class="flex items-center gap-1 rounded-full bg-surface-alt/70 p-1" role="list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-10 items-center whitespace-nowrap rounded-full px-3 text-sm font-semibold 2xl:px-4 no-underline transition-all duration-300',
                  item.current
                    ? 'bg-primary text-on-primary shadow-card hover:text-on-primary'
                    : 'text-text hover:bg-surface hover:text-primary hover:shadow-card',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ms-auto flex items-center gap-2 xl:ms-2">
      <div class="hidden sm:block">
        <LanguageSwitcher locale={locale} alternates={alternates} />
      </div>
      <MotionToggle locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>

  <!-- Mobile and tablet: disclosure menu (no JavaScript) -->
  <div class="container-page flex flex-wrap items-start justify-between gap-2 pb-2 xl:hidden">
  <nav aria-label={t(locale, 'nav.label')} class="min-w-0 flex-1">
    <details>
      <summary
        class="menu-toggle inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-border px-4 text-sm font-semibold text-text hover:bg-surface-alt"
      >
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        {t(locale, 'nav.menu')}
      </summary>
      <ul class="mt-2 grid gap-1 rounded-lg bg-surface p-2 shadow-card sm:grid-cols-2" role="list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-md px-3 font-semibold no-underline',
                  item.current ? 'bg-primary text-on-primary hover:text-on-primary' : 'text-text hover:bg-surface-alt',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
  <div class="sm:hidden">
    <LanguageSwitcher locale={locale} alternates={alternates} />
  </div>
  </div>
</header>
