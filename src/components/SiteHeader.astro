---
// Site header: logo, language pill and a round menu button that opens a full-screen menu.
// The menu uses <details>/<summary>: it works without JavaScript (strict CSP, no inline scripts);
// src/scripts/interactions.ts only adds Escape-to-close and focus return.
import type { Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { isCurrent, mainNav, navHref } from '~/config/navigation';
import { site } from '~/config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import MotionToggle from './MotionToggle.astro';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates } = Astro.props;
const pathname = Astro.url.pathname;
const items = mainNav.map((item) => ({
  label: t(locale, item.label),
  href: navHref(locale, item.slug),
  current: isCurrent(pathname, locale, item.slug),
}));
---

<header class="site-header">
  <div class="container-page relative z-10 flex items-center gap-2 py-3 sm:gap-3">
    <a href={navHref(locale, '')} class="header-brand group flex min-w-0 items-center gap-2.5 no-underline sm:gap-3">
      <span class="site-logo medallion size-11 shrink-0 transition-transform duration-500 group-hover:rotate-12 sm:size-12">
        <Logo size={44} alt="" eager />
      </span>
      <span class="flex min-w-0 flex-col">
        <span class="whitespace-nowrap text-base font-extrabold leading-tight sm:text-lg">{t(locale, 'site.shortName')}</span>
        <span class="header-sub hidden max-w-xs truncate text-xs leading-snug lg:block">{t(locale, 'site.name')}</span>
      </span>
    </a>

    <div class="ms-auto flex items-center gap-2">
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <details class="site-menu" data-site-menu>
        <summary class="menu-button" title={t(locale, 'nav.menu')}>
          <span class="sr-only">{t(locale, 'nav.menu')}</span>
          <svg class="icon-open" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M4 8h16M4 16h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
          <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
        </summary>

        <div class="menu-overlay on-inverse">
          <nav aria-label={t(locale, 'nav.label')} class="container-page flex min-h-full flex-col pb-8 pt-28">
            <ul class="menu-list flex flex-col gap-1" role="list">
              {
                items.map((item, index) => (
                  <li class:list={[`menu-d${Math.min(index + 1, 9)}`]}>
                    <a href={item.href} aria-current={item.current ? 'page' : undefined} class="menu-link">
                      <span class="menu-index" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-4 border-t border-white/15 pt-6">
              <a href={`mailto:${site.email}`} dir="ltr" class="ltr-inline font-semibold">{site.email}</a>
              <div class="flex items-center gap-2">
                <MotionToggle locale={locale} />
              </div>
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
