---
import { localeMeta, locales, type Locale } from '~/i18n/config';
import { localizedPath, t } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
---

<nav aria-label={t(locale, 'lang.switchLabel')}>
  <ul class="flex gap-3" role="list">
    {
      locales.map((code) => (
        <li>
          {code === locale ? (
            <span aria-current="true" class="font-semibold" lang={code}>
              {localeMeta[code].label}
            </span>
          ) : (
            <a href={localizedPath(pathname, code)} hreflang={localeMeta[code].hreflang} lang={code}>
              {localeMeta[code].label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
