---
// Language switch as a compact pill (ع · FR · EN). The full language name is read by screen readers.
import { localeMeta, locales, type Locale } from '~/i18n/config';
import { localizedPath, t } from '~/i18n/utils';

interface Props {
  locale: Locale;
  /** Override target paths (e.g. an article that only exists in some languages). */
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates = {} } = Astro.props;
const pathname = Astro.url.pathname;
const short: Record<Locale, string> = { ar: 'ع', fr: 'FR', en: 'EN' };
const item = 'grid size-10 place-items-center rounded-full text-sm font-bold no-underline transition-colors duration-300';
---

<nav aria-label={t(locale, 'lang.switchLabel')} class="lang-pill">
  <ul class="flex items-center gap-0.5 rounded-full p-1" role="list">
    {
      locales.map((code) => (
        <li>
          {code === locale ? (
            <span aria-current="true" class:list={[item, 'lang-current']} lang={code}>
              <span aria-hidden="true">{short[code]}</span>
              <span class="sr-only">{`${localeMeta[code].label} ${t(locale, 'lang.current')}`}</span>
            </span>
          ) : (
            <a
              href={alternates[code] ?? localizedPath(pathname, code)}
              hreflang={localeMeta[code].hreflang}
              lang={code}
              class:list={[item, 'lang-link']}
            >
              {short[code]}
              <span class="sr-only">{` ${localeMeta[code].label}`}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
