---
// Responsive images from content entries. Astro re-encodes them (WebP, resized, metadata stripped).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Language of the alt texts when it differs from the page. */
  lang?: string | undefined;
}

const { images, lang } = Astro.props;
---

{
  images.length > 0 && (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2" role="list" lang={lang}>
      {images.map((image) => (
        <li>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 640px) 50vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="aspect-video w-full rounded-lg bg-surface-alt object-cover"
          />
        </li>
      ))}
    </ul>
  )
}
