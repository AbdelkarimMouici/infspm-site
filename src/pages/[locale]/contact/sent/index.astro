---
// Result page after a contact-form submission (static; the Pages Function redirects here). Not indexed.
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Button from '~/components/Button.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} title={t(locale, 'contact.sent.title')} description={t(locale, 'contact.sent.body')} noindex>
  <PageHeader title={t(locale, 'contact.sent.title')} />
  <div class="container-page space-y-6 py-8">
    <p class="max-w-prose text-lg" role="status">{t(locale, 'contact.sent.body')}</p>
    
    <Button href={`/${locale}/contact/`} variant="secondary">{t(locale, 'contact.back')}</Button>
  </div>
</BaseLayout>
