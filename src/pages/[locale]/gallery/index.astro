---
// Gallery: images from published news and activities (consent rules apply upstream, docs/CONTENT.md).
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import EmptyState from '~/components/EmptyState.astro';
import NeedsReviewNotice from '~/components/NeedsReviewNotice.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { getLocalizedEntries } from '~/lib/localized';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const sources = [
  ...(await getLocalizedEntries('news', locale)).map((item) => ({ item, section: 'news' })),
  ...(await getLocalizedEntries('activities', locale)).map((item) => ({ item, section: 'activities' })),
].sort((a, b) => b.item.entry.data.date.getTime() - a.item.entry.data.date.getTime());

const photos = sources.flatMap(({ item, section }) =>
  item.entry.data.images.map((image) => ({
    ...image,
    href: `/${locale}/${section}/${item.slug}/`,
    lang: item.isFallback ? item.contentLocale : undefined,
    caption: item.entry.data.title,
  })),
);
---

<BaseLayout locale={locale} title={t(locale, 'gallery.title')} description={t(locale, 'gallery.description')}>
  <PageHeader title={t(locale, 'gallery.title')} lead={t(locale, 'gallery.lead')}>
    <Breadcrumbs
      slot="before"
      locale={locale}
      items={[{ label: t(locale, 'nav.home'), href: `/${locale}/` }, { label: t(locale, 'gallery.title') }]}
    />
  </PageHeader>
  <div class="container-page py-8">
    <NeedsReviewNotice locale={locale} />
    <div class="mt-6">
      {
        photos.length === 0 ? (
          <EmptyState message={t(locale, 'gallery.empty')} />
        ) : (
          <ul class="grid grid-cols-2 gap-4 md:grid-cols-3" role="list">
            {photos.map((photo) => (
              <li>
                <figure>
                  <a href={photo.href} class="block no-underline">
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[320, 640]}
                      sizes="(min-width: 768px) 33vw, 50vw"
                      format="webp"
                      loading="lazy"
                      decoding="async"
                      class="aspect-square w-full rounded-lg bg-surface-alt object-cover"
                      lang={photo.lang}
                    />
                    <figcaption class="mt-2 text-sm text-text" lang={photo.lang}>
                      {photo.caption}
                    </figcaption>
                  </a>
                </figure>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</BaseLayout>
