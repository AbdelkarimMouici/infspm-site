---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import EntryList from '~/components/EntryList.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import { getLocalizedEntries } from '~/lib/localized';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const items = (await getLocalizedEntries('news', locale)).sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
---

<BaseLayout locale={locale} title={t(locale, 'news.title')} description={t(locale, 'news.description')}>
  <PageHeader title={t(locale, 'news.title')} lead={t(locale, 'news.lead')}>
    <Breadcrumbs slot="before" locale={locale} items={[{ label: t(locale, 'nav.home'), href: `/${locale}/` }, { label: t(locale, 'news.title') }]} />
  </PageHeader>
  <div class="container-page py-8">
    <div class="mt-6">
      <EntryList locale={locale} items={items} section="news" emptyMessage={t(locale, 'news.empty')} />
    </div>
  </div>
</BaseLayout>
