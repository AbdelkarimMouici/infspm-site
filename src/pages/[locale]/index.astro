---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/Card.astro';
import EntryList from '~/components/EntryList.astro';
import NeedsReviewNotice from '~/components/NeedsReviewNotice.astro';
import Scene3D from '~/components/Scene3D.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import type { UIKey } from '~/i18n/ui';
import { getLocalizedEntries } from '~/lib/localized';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const newest = <T extends { entry: { data: { date: Date } } }>(items: T[]) =>
  items.sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime()).slice(0, 3);
const news = newest(await getLocalizedEntries('news', locale));
const activities = newest(await getLocalizedEntries('activities', locale));

const quickLinks: { title: UIKey; text: UIKey; slug: string; icon: 'book' | 'register' | 'news' | 'contact' }[] = [
  { title: 'nav.programs', text: 'home.quick.programs', slug: 'programs', icon: 'book' },
  { title: 'nav.admissions', text: 'home.quick.admissions', slug: 'admissions', icon: 'register' },
  { title: 'nav.news', text: 'home.quick.news', slug: 'news', icon: 'news' },
  { title: 'nav.contact', text: 'home.quick.contact', slug: 'contact', icon: 'contact' },
];

const organs: { scene: string; label: UIKey }[] = [
  { scene: 'explore-heart', label: 'explore.heart' },
  { scene: 'explore-lungs', label: 'explore.lungs' },
  { scene: 'explore-brain', label: 'explore.brain' },
  { scene: 'explore-dna', label: 'explore.dna' },
];
---

<BaseLayout locale={locale} title={t(locale, 'home.title')} description={t(locale, 'home.description')}>
  <section class="hero" aria-labelledby="home-title">
    <div class="container-page grid items-center gap-4 pb-14 pt-4 md:pt-8 lg:grid-cols-[1.1fr_1fr] lg:gap-10 lg:pb-20">
      <!-- Interactive 3D heart that assembles itself, then beats; static illustration without it. -->
      <div class="relative lg:order-2">
        <Scene3D scene="hero" fallback="large" class="mx-auto aspect-square w-full max-w-sm sm:max-w-md lg:max-w-xl" />
        <p class="needs-3d play-hint text-muted">{t(locale, 'home.play.hint')}</p>
      </div>
      <div class="lg:order-1">
        <p class="hero-pill rise">{t(locale, 'home.eyebrow')}</p>
        <h1 id="home-title" class="hero-title rise rise-d1 mt-6">{t(locale, 'site.name')}</h1>
        <p class="rise rise-d2 mt-6 max-w-xl text-lg leading-relaxed text-muted md:text-xl">{t(locale, 'home.intro')}</p>
        <div class="rise rise-d2 mt-8 flex flex-col gap-3 sm:flex-row">
          <a data-magnetic href={`/${locale}/programs/`} class="btn-solid">
            {t(locale, 'nav.programs')}
            <svg class="rtl:-scale-x-100" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a data-magnetic href={`/${locale}/about/`} class="btn-line">{t(locale, 'home.discover')}</a>
        </div>
        <p class="scroll-cue mt-12 hidden lg:inline-flex" aria-hidden="true">{t(locale, 'home.scroll')}</p>
      </div>
    </div>
  </section>

  <div class="container-page py-14">
    <NeedsReviewNotice locale={locale} />

    <section aria-labelledby="quick-links" class="mt-8">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="eyebrow reveal">{t(locale, 'home.eyebrow')}</p>
          <h2 id="quick-links" class="reveal reveal-d1 mt-2 text-2xl font-extrabold md:text-4xl">
            <span class="text-gradient">{t(locale, 'home.quickLinks')}</span>
          </h2>
        </div>
        <Scene3D scene="quick" class="size-28 shrink-0 md:size-44" />
      </div>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          quickLinks.map((link, index) => (
            <li class:list={[`reveal-d${index + 1}`]}>
              <Card title={t(locale, link.title)} href={`/${locale}/${link.slug}/`} icon={link.icon}>
                <p>{t(locale, link.text)}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

  </div>

  <section aria-labelledby="explore-title" class="needs-3d slant-band mt-20" data-explorer>
    <div class="container-page grid items-center gap-8 lg:grid-cols-[1fr_1.35fr]">
      <div>
        <p class="eyebrow">{t(locale, 'home.eyebrow')}</p>
        <h2 id="explore-title" class="mt-3 text-3xl font-extrabold md:text-5xl">{t(locale, 'home.play.title')}</h2>
        <p class="mt-4 max-w-md text-lg text-on-inverse-muted">{t(locale, 'home.play.text')}</p>
        <ul class="mt-6 flex flex-wrap gap-2 lg:mt-8 lg:grid lg:gap-3" role="list">
          {
            organs.map((organ, index) => (
              <li>
                <button type="button" class="explore-option" data-explore={organ.scene} aria-pressed={index === 0 ? 'true' : 'false'}>
                  <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  {t(locale, organ.label)}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <Scene3D scene="explore-heart" mode="rotate" class="h-[24rem] w-full md:h-[32rem]" />
    </div>
  </section>

  <div class="container-page pb-14">
    <section aria-labelledby="latest-news" class="mt-12">
      <div class="reveal flex items-center justify-between gap-3">
        <div class="flex flex-wrap items-end gap-x-6 gap-y-2">
          <h2 id="latest-news" class="text-2xl font-extrabold md:text-4xl">
            <span class="text-gradient">{t(locale, 'home.latestNews')}</span>
          </h2>
          <a href={`/${locale}/news/`} class="font-bold">{t(locale, 'home.allNews')}</a>
        </div>
        <Scene3D scene="home-news" class="size-24 shrink-0 md:size-36" />
      </div>
      <div class="mt-8">
        <EntryList locale={locale} items={news} section="news" emptyMessage={t(locale, 'news.empty')} level={3} />
      </div>
    </section>

    <section aria-labelledby="latest-activities" class="mt-16">
      <div class="reveal flex items-center justify-between gap-3">
        <div class="flex flex-wrap items-end gap-x-6 gap-y-2">
          <h2 id="latest-activities" class="text-2xl font-extrabold md:text-4xl">
            <span class="text-gradient">{t(locale, 'home.latestActivities')}</span>
          </h2>
          <a href={`/${locale}/activities/`} class="font-bold">{t(locale, 'home.allActivities')}</a>
        </div>
        <Scene3D scene="home-activities" class="size-24 shrink-0 md:size-36" />
      </div>
      <div class="mt-8">
        <EntryList
          locale={locale}
          items={activities}
          section="activities"
          emptyMessage={t(locale, 'activities.empty')}
          level={3}
        />
      </div>
    </section>
  </div>
</BaseLayout>
