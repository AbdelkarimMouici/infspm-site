---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import NeedsReviewNotice from '~/components/NeedsReviewNotice.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} title={t(locale, 'home.title')} description={t(locale, 'home.description')}>
  <PageHeader title={t(locale, 'site.name')} lead={t(locale, 'home.underConstruction')} />
  <div class="container-page py-8">
    <NeedsReviewNotice locale={locale} />
  </div>
</BaseLayout>
