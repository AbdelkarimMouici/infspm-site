---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/Card.astro';
import EntryList from '~/components/EntryList.astro';
import Logo from '~/components/Logo.astro';
import NeedsReviewNotice from '~/components/NeedsReviewNotice.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';
import type { UIKey } from '~/i18n/ui';
import { getLocalizedEntries } from '~/lib/localized';
import { getLogo } from '~/lib/logo';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const newest = <T extends { entry: { data: { date: Date } } }>(items: T[]) =>
  items.sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime()).slice(0, 3);
const news = newest(await getLocalizedEntries('news', locale));
const activities = newest(await getLocalizedEntries('activities', locale));

const quickLinks: { title: UIKey; text: UIKey; slug: string; icon: 'book' | 'register' | 'news' | 'contact' }[] = [
  { title: 'nav.programs', text: 'home.quick.programs', slug: 'programs', icon: 'book' },
  { title: 'nav.admissions', text: 'home.quick.admissions', slug: 'admissions', icon: 'register' },
  { title: 'nav.news', text: 'home.quick.news', slug: 'news', icon: 'news' },
  { title: 'nav.contact', text: 'home.quick.contact', slug: 'contact', icon: 'contact' },
];
// Logo texture for the 3D medallion (same-origin, optimised WebP).
const logo = getLogo();
const logoTextureUrl = logo ? (await getImage({ src: logo, width: 1024, height: 1024, format: 'webp' })).src : undefined;

const btn =
  'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 font-bold no-underline transition-all duration-300 hover:-translate-y-0.5';
---

<BaseLayout locale={locale} title={t(locale, 'home.title')} description={t(locale, 'home.description')}>
  <section class="on-inverse brand-band" aria-labelledby="home-title">
    <div class="brand-grid" aria-hidden="true"></div>
    <div class="container-page grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="eyebrow rise">{t(locale, 'home.eyebrow')}</p>
        <h1 id="home-title" class="rise rise-d1 mt-4 text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">
          <span class="text-shimmer">{t(locale, 'site.name')}</span>
        </h1>
        <p class="rise rise-d2 mt-6 max-w-xl text-lg leading-relaxed md:text-xl">{t(locale, 'home.intro')}</p>
        <div class="rise rise-d2 mt-8 flex flex-wrap gap-3">
          <a data-magnetic href={`/${locale}/programs/`} class:list={[btn, 'btn bg-white text-primary shadow-lift hover:text-primary']}>
            {t(locale, 'nav.programs')}
            <svg class="rtl:-scale-x-100" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a
            data-magnetic
            href={`/${locale}/about/`}
            class:list={[btn, 'btn border border-white/40 text-white hover:bg-white/10 hover:text-white']}
          >
            {t(locale, 'home.discover')}
          </a>
        </div>
      </div>

      <!--
        Hero visual: an interactive 3D scene (logo medallion, DNA helix, particles) loaded after the page displays.
        The CSS version below (logo in orbit) shows first and stays when 3D is skipped (reduced motion, data saver…).
      -->
      <div
        class="hero-visual relative mx-auto grid aspect-square w-full max-w-lg place-items-center"
        aria-hidden="true"
        data-hero-3d
        data-logo={logoTextureUrl}
      >
        <canvas class="hero-canvas"></canvas>
        <div class="hero-fallback absolute inset-0 grid place-items-center">
          <span class="orbit orbit-1"></span>
          <span class="orbit orbit-2"></span>
          <span class="orbit orbit-3"></span>
          <span class="medallion float size-56 md:size-72">
            <Logo size={288} alt="" eager />
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page py-14">
    <NeedsReviewNotice locale={locale} />

    <section aria-labelledby="quick-links" class="mt-8">
      <p class="eyebrow reveal">{t(locale, 'home.eyebrow')}</p>
      <h2 id="quick-links" class="reveal reveal-d1 mt-2 text-2xl font-extrabold md:text-4xl">
        <span class="text-gradient">{t(locale, 'home.quickLinks')}</span>
      </h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          quickLinks.map((link, index) => (
            <li class:list={[`reveal-d${index + 1}`]}>
              <Card title={t(locale, link.title)} href={`/${locale}/${link.slug}/`} icon={link.icon}>
                <p>{t(locale, link.text)}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="latest-news" class="mt-20">
      <div class="reveal flex flex-wrap items-end justify-between gap-3">
        <h2 id="latest-news" class="text-2xl font-extrabold md:text-4xl">
          <span class="text-gradient">{t(locale, 'home.latestNews')}</span>
        </h2>
        <a href={`/${locale}/news/`} class="font-bold">{t(locale, 'home.allNews')}</a>
      </div>
      <div class="mt-8">
        <EntryList locale={locale} items={news} section="news" emptyMessage={t(locale, 'news.empty')} level={3} />
      </div>
    </section>

    <section aria-labelledby="latest-activities" class="mt-20">
      <div class="reveal flex flex-wrap items-end justify-between gap-3">
        <h2 id="latest-activities" class="text-2xl font-extrabold md:text-4xl">
          <span class="text-gradient">{t(locale, 'home.latestActivities')}</span>
        </h2>
        <a href={`/${locale}/activities/`} class="font-bold">{t(locale, 'home.allActivities')}</a>
      </div>
      <div class="mt-8">
        <EntryList
          locale={locale}
          items={activities}
          section="activities"
          emptyMessage={t(locale, 'activities.empty')}
          level={3}
        />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '~/scripts/hero-loader';
</script>
