---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { locales, type Locale } from '~/i18n/config';
import { t } from '~/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} title={t(locale, 'home.title')} description={t(locale, 'home.description')}>
  <h1 class="mb-4 text-2xl font-bold md:text-3xl">{t(locale, 'site.name')}</h1>
  <p class="max-w-prose text-muted">{t(locale, 'home.underConstruction')}</p>
</BaseLayout>
