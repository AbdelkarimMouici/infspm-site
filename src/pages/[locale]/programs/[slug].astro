---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Prose from '~/components/Prose.astro';
import FallbackNotice from '~/components/FallbackNotice.astro';
import Button from '~/components/Button.astro';
import type { Locale } from '~/i18n/config';
import { getDir, t } from '~/i18n/utils';
import { localizedPaths, switcherTargets, translationAlternates, type LocalizedEntry } from '~/lib/localized';

export async function getStaticPaths() {
  return localizedPaths('programs');
}

interface Props {
  item: LocalizedEntry<'programs'>;
}

const locale = Astro.params.locale as Locale;
const { item } = Astro.props;
const { entry, isFallback, contentLocale } = item;
const data = entry.data;
const { Content } = await render(entry);
const alternates = await translationAlternates('programs', item.slug, 'programs');
const switchTargets = await switcherTargets('programs', item.slug, 'programs');
const contentAttrs = isFallback ? { lang: contentLocale, dir: getDir(contentLocale) } : {};

// Key facts. Unknown values are shown as "to be confirmed", never guessed (TODO(content)).
const facts = [
  { label: t(locale, 'programs.duration'), value: data.duration },
  { label: t(locale, 'programs.diploma'), value: data.diploma },
  { label: t(locale, 'programs.admission'), value: data.admission },
];
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={isFallback
    ? `${data.title} (${t(locale, 'content.onlyInArabicShort')}) – ${t(locale, 'programs.description')}`
    : (data.summary ?? t(locale, 'programs.description'))}
  alternates={alternates}
  switchTargets={switchTargets}
  noindex={isFallback}
>
  <PageHeader title={data.title} titleLang={isFallback ? contentLocale : undefined}>
    <Breadcrumbs
      slot="before"
      locale={locale}
      items={[
        { label: t(locale, 'nav.home'), href: `/${locale}/` },
        { label: t(locale, 'programs.title'), href: `/${locale}/programs/` },
        { label: data.title, lang: isFallback ? contentLocale : undefined },
      ]}
    />
  </PageHeader>
  <article class="container-page py-8">
    <FallbackNotice locale={locale} show={isFallback} />

    <section aria-labelledby="key-facts" class="my-6 rounded-lg border border-border bg-surface-alt p-5">
      <h2 id="key-facts" class="text-lg font-bold">{t(locale, 'programs.keyFacts')}</h2>
      <dl class="mt-3 grid gap-4 sm:grid-cols-3">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-sm font-semibold text-muted">{fact.label}</dt>
              <dd class="mt-1" {...(fact.value ? contentAttrs : {})}>
                {fact.value ?? t(locale, 'common.toBeConfirmed')}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <Prose {...contentAttrs}>
      <Content />
    </Prose>

    <p class="mt-8">
      <Button href={`/${locale}/admissions/`} variant="secondary">{t(locale, 'programs.seeAdmissions')}</Button>
    </p>
  </article>
</BaseLayout>
