---
// Root "/" sends visitors to the Arabic home page.
// On Cloudflare Pages, public/_redirects answers "/" with a 301 to "/ar/" before this file is served.
// This page is the fallback for other hosts: a static meta refresh (no script) plus visible links.
// It is noindex and carries no canonical/hreflang (those would conflict with noindex).
import { localeMeta } from '~/i18n/config';
import { t } from '~/i18n/utils';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('ar', 'site.name')}</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/ar/" />
  </head>
  <body>
    <main>
      <h1>{t('ar', 'site.name')}</h1>
      <ul>
        <li><a href="/ar/" hreflang="ar">{localeMeta.ar.label}</a></li>
        <li><a href="/fr/" hreflang="fr" lang="fr">{localeMeta.fr.label}</a></li>
        <li><a href="/en/" hreflang="en" lang="en">{localeMeta.en.label}</a></li>
      </ul>
    </main>
  </body>
</html>
